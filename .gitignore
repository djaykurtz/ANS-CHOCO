# Vault secrets — never commit
vault/
inventory/vault/

# Reports generated by chocoDeploy
playbooks/reports/

# Repo-local collections installed from requirements.yml
/collections/

# Ansible retry files
*.retry

# Python
__pycache__/
*.pyc
.venv/
.demo/

# IDE / workspace
*.code-workspace
.copilot/
.github/copilot-chat/

# Local working notes under _requirements/ (never tracked).
# _requirements/TOOLING_VERSIONS.md IS tracked; these two are local-only by their
# own terms and must not be published with the repository.
_requirements/AGENTS.md
_requirements/WRITING_STYLE.md

# Inventories: allowlist. Only the stable inventories belong in the repo; every
# per-campaign target list carries real fleet hostnames and lives in the external
# campaign store instead. Add a new dir here only if it is a standing environment.
inventory/*
!inventory/TEST/
!inventory/Internalize/
inventory/TEST/*-temp.yml

# Operational campaign manifests and raw target lists stay outside the repo.
# Keep only the reusable template under campaigns/.
campaigns/*.yml
!campaigns/template.yml
campaigns/*.csv

# Dated one-off test-pin scratch files (not permanent role assets)
playbooks/roles/chocoDeploy/files/test-pins/
