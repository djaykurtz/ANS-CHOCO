<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>softwareUsage -- {{ inventory_hostname }}</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #1e1e1e;
  color: #d4d4d4;
  line-height: 1.55;
  font-size: 15px;
  padding: 1.5rem;
}
.wrap { max-width: 1100px; margin: 0 auto; }
header {
  background: #0078d4;
  color: #fff;
  padding: 0.75rem 1.5rem;
  border-radius: 8px 8px 0 0;
}
header h1 { font-size: 1.3rem; font-weight: 600; }
.meta { margin-top: 0.3rem; font-size: 0.9rem; opacity: 0.9; }
.meta span { display: inline-block; margin-right: 1.6rem; }
.meta .system-name { font-weight: 600; font-size: 1.05rem; }

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  padding: 1rem 1.5rem;
  background: #252526;
  border-bottom: 1px solid #3c3c3c;
  justify-content: center;
}
.stat {
  text-align: center;
  padding: 0.55rem 1.1rem;
  border-radius: 6px;
  min-width: 130px;
}
.stat .count { font-size: 1.7rem; font-weight: 700; }
.stat .label { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; }
.stat-used      { background: #1a2e1a; color: #6a9955; }
.stat-unused    { background: #332b1a; color: #ce9178; }
.stat-auditoff  { background: #3a1a1a; color: #f48771; }
.stat-events    { background: #1a2733; color: #569cd6; }

section {
  background: #252526;
  padding: 0.85rem 1.5rem;
  border-bottom: 1px solid #3c3c3c;
}
section:last-of-type {
  border-radius: 0 0 8px 8px;
  border-bottom: none;
}
h2 { font-size: 1.1rem; margin-bottom: 0.5rem; color: #e0e0e0; }
h3 { font-size: 1rem; margin: 0.8rem 0 0.3rem; color: #d4d4d4; }

table { width: 100%; border-collapse: collapse; font-size: 0.95rem; margin-top: 0.25rem; }
th {
  text-align: left;
  padding: 0.45rem 0.65rem;
  background: #2d2d2d;
  border-bottom: 2px solid #3c3c3c;
  font-weight: 600;
  color: #569cd6;
}
td { padding: 0.4rem 0.65rem; border-bottom: 1px solid #333; color: #d4d4d4; vertical-align: top; }
tr:nth-child(even) td { background: #2a2a2a; }

.verdict-pill {
  display: inline-block;
  padding: 0.1rem 0.55rem;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.verdict-used     { background: #1a2e1a; color: #6a9955; }
.verdict-unused   { background: #332b1a; color: #ce9178; }
.verdict-auditoff { background: #3a1a1a; color: #f48771; }

.mono, .cmdline, .parent, .user {
  font-family: 'Cascadia Code', Consolas, 'Courier New', monospace;
  font-size: 0.86rem;
}
.cmdline {
  color: #ce9178;
  white-space: pre-wrap;
  word-break: break-all;
  max-width: 540px;
  display: inline-block;
}

dl {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 0.25rem 1rem;
  font-size: 0.95rem;
}
dt { font-weight: 600; color: #9cdcfe; }
dd { word-break: break-all; color: #d4d4d4; }

.none { color: #6a6a6a; font-style: italic; padding: 0.2rem 0; }
.error-banner {
  background: #4a1a1a;
  color: #f48771;
  padding: 0.55rem 0.75rem;
  border-left: 3px solid #f48771;
  border-radius: 4px;
  margin: 0.4rem 0;
  font-size: 0.92rem;
}
.warn-banner {
  background: #4a3b1a;
  color: #ffd700;
  padding: 0.55rem 0.75rem;
  border-left: 3px solid #ffd700;
  border-radius: 4px;
  margin: 0.4rem 0;
  font-size: 0.92rem;
}
footer {
  text-align: center;
  padding: 0.8rem;
  font-size: 0.74rem;
  color: #6a6a6a;
}
details > summary {
  cursor: pointer;
  font-size: 0.88rem;
  color: #9cdcfe;
  padding: 0.3rem 0;
}
details[open] > summary { color: #569cd6; }
</style>
</head>
<body>
<div class="wrap">

{% set d = _usage_data %}
{% set apps = d.apps %}
{% set used    = apps.values() | selectattr('verdict','equalto','used_recently')   | list %}
{% set unused  = apps.values() | selectattr('verdict','equalto','unused_in_window') | list %}
{% set audoff  = apps.values() | selectattr('verdict','equalto','audit_off')        | list %}

<header>
  <h1>softwareUsage report</h1>
  <div class="meta">
    <span class="system-name">{{ d.host }}</span>
    <span>collected {{ d.collected_at }}</span>
    <span>lookback {{ d.lookback_days }}d</span>
    <span>threshold &gt;= {{ d.min_executions }}</span>
  </div>
</header>

<div class="stats">
  <div class="stat stat-used"><div class="count">{{ used | length }}</div><div class="label">Used recently</div></div>
  <div class="stat stat-unused"><div class="count">{{ unused | length }}</div><div class="label">Unused in window</div></div>
  <div class="stat stat-auditoff"><div class="count">{{ audoff | length }}</div><div class="label">Audit off</div></div>
  <div class="stat stat-events"><div class="count">{{ d.events_matched }}</div><div class="label">Matched events</div></div>
  <div class="stat stat-events"><div class="count">{{ d.events_examined }}</div><div class="label">Examined events</div></div>
  <div class="stat stat-events"><div class="count">{{ d.scan_duration_sec }}s</div><div class="label">Scan duration</div></div>
</div>

<section>
  <h2>Collection environment</h2>
  {% if not d.audit_on %}
    <div class="error-banner">
      <strong>Process Creation auditing is OFF on this host.</strong>
      Without "Audit Process Creation = Success" in audit policy, no EventID 4688 events exist
      to read. Every app is marked verdict=audit_off. Enable via GPO or
      <code>auditpol /set /subcategory:"Process Creation" /success:enable</code>.
    </div>
  {% elif not d.cmdline_capture %}
    <div class="warn-banner">
      <strong>Command-line capture is OFF.</strong>
      Process Creation auditing is on (we can count executions), but EventID 4688 events
      do not include the CommandLine field. Per-app "details" rows will not show script
      paths or arguments. Enable via the GPO
      <code>Administrative Templates &raquo; System &raquo; Audit Process Creation
      &raquo; Include command line</code>.
    </div>
  {% endif %}

  <dl>
    <dt>Audit Process Creation</dt>          <dd>{{ 'enabled' if d.audit_on else 'DISABLED' }}</dd>
    <dt>Command-line capture</dt>            <dd>{{ 'enabled' if d.cmdline_capture else 'disabled' }}</dd>
    <dt>Events examined</dt>                 <dd>{{ d.events_examined }}</dd>
    <dt>Events matched catalog</dt>          <dd>{{ d.events_matched }}</dd>
    <dt>Scan duration</dt>                   <dd>{{ d.scan_duration_sec }} seconds</dd>
    {% if d.errors and d.errors | length > 0 %}
    <dt>Errors</dt>                          <dd>{{ d.errors | join('; ') }}</dd>
    {% endif %}
  </dl>
</section>

<section>
  <h2>Per-app verdicts</h2>
  <table>
    <thead>
      <tr>
        <th>App</th>
        <th>Verdict</th>
        <th style="text-align:right">Executions</th>
        <th style="text-align:right">Distinct users</th>
        <th style="text-align:right">Distinct parents</th>
        <th>First seen</th>
        <th>Last seen</th>
      </tr>
    </thead>
    <tbody>
    {% for key, app in apps | dictsort %}
      <tr>
        <td><strong>{{ app.label }}</strong> <span class="mono" style="color:#6a6a6a">({{ key }})</span></td>
        <td>
          {% if app.verdict == 'used_recently' %}
            <span class="verdict-pill verdict-used">used</span>
          {% elif app.verdict == 'unused_in_window' %}
            <span class="verdict-pill verdict-unused">unused</span>
          {% else %}
            <span class="verdict-pill verdict-auditoff">audit off</span>
          {% endif %}
        </td>
        <td style="text-align:right">{{ app.executions }}</td>
        <td style="text-align:right">{{ app.distinct_users }}</td>
        <td style="text-align:right">{{ app.distinct_parents }}</td>
        <td>{{ app.first or '-' }}</td>
        <td>{{ app.last or '-' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<section>
  <h2>Per-app details (what invoked each app)</h2>
  {% set has_any_detail = used | selectattr('details') | list | length > 0 %}
  {% if not has_any_detail %}
    <p class="none">No invocation details available (no apps were used in the window, or command-line capture is off).</p>
  {% else %}
    {% for key, app in apps | dictsort %}
      {% if app.executions > 0 %}
        <details>
          <summary>{{ app.label }} ({{ key }}) -- {{ app.executions }} executions across {{ app.details | length }} distinct invocations</summary>
          <table>
            <thead>
              <tr>
                <th style="text-align:right">Count</th>
                <th>Parent</th>
                <th>User</th>
                <th>Command line</th>
                <th>Last seen</th>
              </tr>
            </thead>
            <tbody>
              {% for row in app.details %}
              <tr>
                <td style="text-align:right">{{ row.count }}</td>
                <td><span class="parent">{{ row.parent or '-' }}</span></td>
                <td><span class="user">{{ row.user or '-' }}</span></td>
                <td>
                  {% if row.cmdline %}
                    <span class="cmdline">{{ row.cmdline }}</span>
                  {% else %}
                    <span class="none">(cmdline not captured)</span>
                  {% endif %}
                </td>
                <td>{{ row.last or '-' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </details>
      {% endif %}
    {% endfor %}
  {% endif %}
</section>

<footer>
  softwareUsage report &middot; {{ inventory_hostname }} &middot; generated {{ d.collected_at }}
</footer>

<script type="application/json" id="softwareUsage-data">
{{ _usage_data | to_json }}
</script>

</div>
</body>
</html>
