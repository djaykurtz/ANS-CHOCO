<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>patchReady - {{ patch_ready_report_name }}</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #1e1e1e;
  color: #d4d4d4;
  line-height: 1.5;
  font-size: 16px;
  padding: 1.5rem;
}
.wrap { max-width: 1100px; margin: 0 auto; }
header {
  background: #0078d4;
  color: #fff;
  padding: 0.75rem 2rem;
  border-radius: 8px 8px 0 0;
}
header h1 { font-size: 1.3rem; font-weight: 600; }
.meta { margin-top: 0.25rem; font-size: 1.05rem; opacity: 0.9; }
.meta span { display: inline-block; margin-right: 2rem; }
.overview {
  display: flex;
  gap: 1.5rem;
  align-items: stretch;
  padding: 1rem 2rem;
  background: #252526;
  border-bottom: 1px solid #3c3c3c;
}
.summary-bar {
  display: flex;
  gap: 1rem;
  flex: 0 0 auto;
  align-items: stretch;
}
.summary-stat {
  text-align: center;
  padding: 0.65rem 1.6rem;
  border-radius: 8px;
  min-width: 130px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.summary-stat .count { font-size: 2.1rem; font-weight: 700; }
.summary-stat .label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
.stat-total { background: #1a2733; color: #569cd6; }
.stat-ready { background: #1a2e1a; color: #6a9955; }
.stat-warn  { background: #332b1a; color: #ce9178; }
.stat-fail  { background: #3a1a1a; color: #f48771; }
.reboot-legend {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0.5rem 0.9rem;
  background: #232323;
  border: 1px solid #3c3c3c;
  border-radius: 8px;
}
.reboot-legend h2 { font-size: 0.95rem; margin-bottom: 0.3rem; color: #e0e0e0; }
.reboot-legend .defs { font-size: 0.8rem; color: #9cdcfe; line-height: 1.6; }
section {
  background: #252526;
  padding: 0.6rem 2rem;
  border-bottom: 1px solid #3c3c3c;
}
section:last-of-type {
  border-radius: 0 0 8px 8px;
  border-bottom: none;
}
h2 { font-size: 1.15rem; margin-bottom: 0.3rem; color: #e0e0e0; }
details { width: 100%; }
details > summary {
  cursor: pointer;
  font-size: 1.15rem;
  font-weight: 600;
  color: #e0e0e0;
  padding: 0.35rem 0;
  list-style: none;
  user-select: none;
}
details > summary::-webkit-details-marker { display: none; }
details > summary::before {
  content: '\25B6';
  display: inline-block;
  margin-right: 0.5rem;
  font-size: 0.8rem;
  color: #9cdcfe;
  transition: transform 0.15s ease;
}
details[open] > summary::before { transform: rotate(90deg); }
.summary-count { color: #9cdcfe; font-weight: 400; font-size: 0.95rem; }
table { width: 100%; border-collapse: collapse; font-size: 0.95rem; margin-top: 0.4rem; }
th {
  text-align: left;
  padding: 0.4rem 0.6rem;
  background: #2d2d2d;
  border-bottom: 2px solid #3c3c3c;
  font-weight: 600;
  color: #569cd6;
  white-space: nowrap;
}
td {
  padding: 0.35rem 0.6rem;
  border-bottom: 1px solid #333;
  color: #d4d4d4;
  white-space: nowrap;
}
tr:nth-child(even) td { background: #2a2a2a; }
.chk-pass { color: #6a9955; font-weight: 600; }
.chk-warn { color: #ce9178; font-weight: 600; }
.chk-fail { color: #f48771; font-weight: 600; }
.chk-skip { color: #6a6a6a; }
.status-ready { color: #6a9955; font-weight: 700; }
.status-warn  { color: #ce9178; font-weight: 700; }
.status-fail  { color: #f48771; font-weight: 700; }
.detail { color: #9cdcfe; font-size: 0.8rem; }
.empty-note { font-size: 0.9rem; color: #6a6a6a; padding: 0.4rem 0; }
footer {
  text-align: center;
  padding: 0.75rem;
  font-size: 0.7rem;
  color: #6a6a6a;
}
</style>
</head>
<body>
{% set all_hosts = ansible_play_hosts | default([]) %}
{% set ns = namespace(ready=0, warn=0, fail=0, problem=[], perfect=[]) %}
{% for h in all_hosts %}
{% set hr = hostvars[h]._pr_host_result | default({}) %}
{% set hs = hostvars[h]._pr_status | default('FAIL') %}
{% if hs == 'READY' %}
{% set ns.ready = ns.ready + 1 %}
{% set ns.perfect = ns.perfect + [hr | combine({'status': hs})] %}
{% else %}
{% if hs == 'WARN' %}{% set ns.warn = ns.warn + 1 %}{% else %}{% set ns.fail = ns.fail + 1 %}{% endif %}
{% set ns.problem = ns.problem + [hr | combine({'status': hs})] %}
{% endif %}
{% endfor %}

{% macro host_row(r) %}
<tr>
<td>{{ r.short_host | default(r.host | default('unknown')) | e }}</td>
<td>{{ r.domain | default('?') }}</td>
<td class="{{ 'chk-pass' if (r.winrm | default(false) | bool) else 'chk-fail' }}">{{ '&#10003;' if (r.winrm | default(false) | bool) else '&#10007;' }}</td>
{% if not (r.winrm | default(false) | bool) %}
<td colspan="4" class="chk-fail" style="white-space:normal">{{ r.fail_reason | default('Unreachable') | e }}</td>
{% else %}
<td class="{{ 'chk-fail' if (r.reboot_actionable | default(false) | bool) else 'chk-pass' }}">{{ ('&#10007; ' ~ (r.reboot_reasons | default([]) | map('regex_replace', ':.*$', '') | join(', '))) if (r.reboot_actionable | default(false) | bool) else ('&#10003; cosmetic' if (r.reboot_pending | default(false) | bool) else '&#10003;') }}</td>
<td class="{{ 'chk-fail' if ((r.disk_free_gb | default(0) | float) < (patch_ready_disk_threshold_gb | float)) else 'chk-pass' }}">{{ r.disk_free_gb | default(0) }}GB / {{ r.disk_total_gb | default(0) }}GB</td>
<td class="{{ 'chk-pass' if (r.choco_ok | default(false) | bool) else 'chk-warn' }}">{{ r.choco_version | default('missing') | e }}</td>
<td>{{ r.uptime_days | default(0) }}d</td>
{% endif %}
<td class="status-{{ r.status | default('fail') | lower }}">{{ 'CHECK' if (r.status == 'WARN') else r.status | default('FAIL') }}</td>
</tr>
{% endmacro %}

{% macro host_table(rows) %}
<table>
<thead>
<tr>
<th>Host</th>
<th>Domain</th>
<th>WinRM</th>
<th>Reboot Flags Present</th>
<th>Disk (C:)</th>
<th>Choco Version</th>
<th>Uptime</th>
<th>Status</th>
</tr>
</thead>
<tbody>
{% for r in rows %}{{ host_row(r) }}{% endfor %}
</tbody>
</table>
{% endmacro %}

<div class="wrap">

<header>
<h1>Patch Readiness Report</h1>
<div class="meta">
<span><strong>Inventory:</strong> {{ (ansible_inventory_sources | default([]) | first | default('unknown') | basename | regex_replace('\\.ya?ml$', '')) }}</span>
<span><strong>Date:</strong> {{ now(utc=true, fmt='%Y-%m-%d %H:%M UTC') }}</span>
</div>
</header>

<div class="overview">
<div class="summary-bar">
<div class="summary-stat stat-total"><div class="count">{{ all_hosts | length }}</div><div class="label">Total</div></div>
<div class="summary-stat stat-ready"><div class="count">{{ ns.ready }}</div><div class="label">Ready</div></div>
<div class="summary-stat stat-warn"><div class="count">{{ ns.warn }}</div><div class="label">Warning</div></div>
<div class="summary-stat stat-fail"><div class="count">{{ ns.fail }}</div><div class="label">Failed</div></div>
</div>
<div class="reboot-legend">
<h2>Reboot Flags</h2>
<div class="defs">
<strong>cosmetic</strong> - temp file cleanup pending, does not affect patching<br>
<strong>SessionMgr</strong> - pending file rename operations (cosmetic)<br>
<strong>CBS</strong> - Windows component servicing update pending reboot<br>
<strong>WU</strong> - Windows Update reboot required
</div>
</div>
</div>

<section>
<details open>
<summary>Standout / Problem Hosts <span class="summary-count">({{ ns.problem | length }})</span></summary>
{% if ns.problem | length > 0 %}
{{ host_table(ns.problem) }}
{% else %}
<div class="empty-note">No problem hosts. Every host is ready.</div>
{% endif %}
</details>
</section>

<section>
<details>
<summary>Ready Hosts <span class="summary-count">({{ ns.perfect | length }})</span></summary>
{% if ns.perfect | length > 0 %}
{{ host_table(ns.perfect) }}
{% else %}
<div class="empty-note">No ready hosts.</div>
{% endif %}
</details>
</section>

<footer>Generated by patchReady &middot; {{ now(utc=true, fmt='%Y%m%dT%H%M%SZ') }}</footer>

</div>
</body>
</html>
